# Copy this file to .env and replace values. Never commit .env.

# Spring profile: local (H2) or postgres
AEXA_PROFILE=local

# PostgreSQL (used when AEXA_PROFILE=postgres or Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aexa
POSTGRES_USER=aexa
POSTGRES_PASSWORD=change-me

# JWT signing secret: generate a long random string for anything beyond local demos
AEXA_JWT_SECRET=local-dev-only-change-me-use-32-plus-chars
AEXA_JWT_EXPIRY_MINUTES=480

# Local bootstrap users (development only)
AEXA_ADMIN_USERNAME=admin
AEXA_ADMIN_PASSWORD=admin-change-me
AEXA_ANALYST_USERNAME=analyst
AEXA_ANALYST_PASSWORD=analyst-change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ML service
ML_SERVICE_URL=http://localhost:8090
ML_SERVICE_TIMEOUT_SECONDS=10

# Telemetry API (set to http://prometheus:9090 only for a backend running inside Compose)
PROMETHEUS_URL=http://localhost:9090

# Demo workload settings
DEPLOYMENT_ENVIRONMENT=demo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317
